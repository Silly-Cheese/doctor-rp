rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActive() {
      return currentUserExists() && currentUser().status == 'active';
    }

    function permission(name, fallback) {
      return currentUser().get('permissions', {}).get(name, fallback);
    }

    function isAdministrator() {
      return isActive() && currentUser().role == 'administrator';
    }

    function isProvider() {
      return isActive()
             && currentUser().role in ['administrator', 'physician']
             && (currentUser().role == 'administrator' || permission('providerActions', true));
    }

    function isNurse() {
      return isActive()
             && currentUser().role in ['administrator', 'nurse']
             && (currentUser().role == 'administrator' || permission('nursingActions', true));
    }

    function isTechnician() {
      return isActive()
             && currentUser().role in ['administrator', 'technician']
             && (currentUser().role == 'administrator' || permission('diagnosticActions', true));
    }

    function canManageRegistration() {
      return isActive()
             && currentUser().role in ['administrator', 'physician', 'nurse', 'registration']
             && (currentUser().role == 'administrator' || permission('manageRegistration', true));
    }

    function canEditPatients() {
      return isActive()
             && currentUser().role in ['administrator', 'physician', 'nurse', 'registration']
             && (currentUser().role == 'administrator' || permission('editPatients', true));
    }

    function canManageRooms() {
      return isActive()
             && currentUser().role in ['administrator', 'physician', 'nurse']
             && (currentUser().role == 'administrator' || permission('manageRooms', true));
    }

    function canMessage() {
      return isActive() && (currentUser().role == 'administrator' || permission('messages', true));
    }

    function canEmergency() {
      return isActive() && (
        currentUser().role == 'administrator'
        || permission('emergencyEvents', currentUser().role in ['physician', 'nurse', 'technician'])
      );
    }

    function validRequestedRole(role) {
      return role in ['physician', 'nurse', 'registration', 'technician', 'pharmacist', 'staff'];
    }

    function validAssignedRole(role) {
      return role in ['administrator', 'physician', 'nurse', 'registration', 'technician', 'pharmacist', 'staff'];
    }

    function validStaffStatus(status) {
      return status in ['active', 'pending', 'suspended'];
    }

    function founderUid() {
      return get(/databases/$(database)/documents/system/setup).data.initializedBy;
    }

    function profileLockFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'profileLocked',
        'profileLockReason',
        'profileLockedByUid',
        'profileLockedByName',
        'profileLockedByStaffId',
        'profileLockedAt',
        'profileLockEpoch',
        'profileLockRemovedAt',
        'profileLockRemovedBy',
        'profileLockRemovedByName',
        'profileLockRemovalReason'
      ]);
    }

    function confidentialEncounterFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'confidential',
        'authorizationSalt',
        'authorizationHash',
        'authorizationEpoch',
        'failedAuthorizationAttempts',
        'permanentlyLocked',
        'confidentialMarkedAt',
        'confidentialMarkedBy',
        'confidentialMarkedByName',
        'authorizationUpdatedAt',
        'authorizationUpdatedBy',
        'lastFailedAuthorizationAt',
        'lastFailedAuthorizationBy',
        'lockedAt',
        'lockedByAttemptUid',
        'lockedByAttemptName',
        'unlockedAt',
        'unlockedBy',
        'unlockedByName'
      ]);
    }

    function canManageEncounterConfidentiality() {
      return isAdministrator()
             || (
               isProvider()
               && (
                 resource.data.get('providerUid', '') == request.auth.uid
                 || (
                   resource.data.get('providerUid', '') == ''
                   && resource.data.status != 'discharged'
                 )
               )
             );
    }

    function validProviderConfidentialUpdate() {
      return canManageEncounterConfidentiality()
             && resource.data.get('permanentlyLocked', false) == false
             && request.resource.data.get('confidential', false) == true
             && request.resource.data.get('authorizationHash', '') != ''
             && request.resource.data.get('authorizationSalt', '') != ''
             && request.resource.data.get('authorizationEpoch', 0) == resource.data.get('authorizationEpoch', 0) + 1
             && request.resource.data.get('failedAuthorizationAttempts', 0) == 0
             && request.resource.data.get('permanentlyLocked', false) == false
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'confidential',
               'authorizationSalt',
               'authorizationHash',
               'authorizationEpoch',
               'failedAuthorizationAttempts',
               'permanentlyLocked',
               'confidentialMarkedAt',
               'confidentialMarkedBy',
               'confidentialMarkedByName',
               'authorizationUpdatedAt',
               'authorizationUpdatedBy',
               'providerUid',
               'providerName',
               'updatedAt'
             ]);
    }

    function validFailedAuthorizationAttempt() {
      return isActive()
             && resource.data.get('confidential', false) == true
             && resource.data.get('permanentlyLocked', false) == false
             && request.resource.data.get('failedAuthorizationAttempts', 0) == resource.data.get('failedAuthorizationAttempts', 0) + 1
             && request.resource.data.get('permanentlyLocked', false) == (request.resource.data.get('failedAuthorizationAttempts', 0) >= 3)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'failedAuthorizationAttempts',
               'permanentlyLocked',
               'lastFailedAuthorizationAt',
               'lastFailedAuthorizationBy',
               'lockedAt',
               'lockedByAttemptUid',
               'lockedByAttemptName',
               'updatedAt'
             ]);
    }

    function validAdministratorCaseUnlock() {
      return isAdministrator()
             && resource.data.get('confidential', false) == true
             && resource.data.get('permanentlyLocked', false) == true
             && request.resource.data.get('permanentlyLocked', true) == false
             && request.resource.data.get('failedAuthorizationAttempts', -1) == 0
             && request.resource.data.get('authorizationEpoch', 0) == resource.data.get('authorizationEpoch', 0) + 1
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'failedAuthorizationAttempts',
               'permanentlyLocked',
               'authorizationEpoch',
               'unlockedAt',
               'unlockedBy',
               'unlockedByName',
               'updatedAt'
             ]);
    }

    match /system/setup {
      allow read: if signedIn();
      allow create: if signedIn()
                    && !exists(/databases/$(database)/documents/system/setup)
                    && request.resource.data.initialized == true
                    && request.resource.data.initializedBy == request.auth.uid
                    && request.resource.data.facilityName == 'Northstar Medical Center';
      allow update: if isAdministrator();
      allow delete: if false;
    }

    match /system/facility {
      allow read: if isActive();
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    // Private, non-clinical shift tasks. Only the owning active staff member can access them.
    match /users/{uid}/workdesk/{taskId} {
      allow read: if isActive() && request.auth.uid == uid;
      allow create: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['title','category','priority','dueDate','completed','createdAt','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 160
        && request.resource.data.category in ['My tasks','Shift preparation','Administrative follow-up','Training']
        && request.resource.data.priority in ['normal','high']
        && request.resource.data.dueDate is string
        && request.resource.data.completed == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActive() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','updatedAt'])
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isActive() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isActive());
      allow create: if signedIn()
                  && request.auth.uid == uid
                  && request.resource.data.uid == request.auth.uid
                  && request.resource.data.email == request.auth.token.email
                  && validRequestedRole(request.resource.data.requestedRole)
                  && !request.resource.data.keys().hasAny([
                    'staffId',
                    'staffCredentialHash',
                    'staffIdStatus',
                    'staffIdIssuedAt',
                    'staffIdIssuedBy',
                    'staffIdVersion'
                  ])
                  && (
                    (
                      !exists(/databases/$(database)/documents/system/setup)
                      && request.resource.data.role == 'administrator'
                      && request.resource.data.status == 'active'
                      && request.resource.data.approvedBy == request.auth.uid
                    )
                    ||
                    (
                      exists(/databases/$(database)/documents/system/setup)
                      && get(/databases/$(database)/documents/system/setup).data.initializedBy == request.auth.uid
                      && request.resource.data.role == 'administrator'
                      && request.resource.data.status == 'active'
                      && request.resource.data.approvedBy == request.auth.uid
                    )
                    ||
                    (
                      exists(/databases/$(database)/documents/system/setup)
                      && request.resource.data.role == 'staff'
                      && request.resource.data.status == 'pending'
                      && !('approvedBy' in request.resource.data)
                    )
                  );
      allow update: if isAdministrator()
                    && validAssignedRole(request.resource.data.role)
                    && validRequestedRole(request.resource.data.requestedRole)
                    && validStaffStatus(request.resource.data.status)
                    && resource.data.get('uid', uid) == uid
                    && request.resource.data.get('uid', uid) == uid
                    && (resource.data.get('email', '') == '' || request.resource.data.get('email', '') == resource.data.get('email', ''))
                    && (uid != founderUid() || (request.resource.data.role == 'administrator' && request.resource.data.status == 'active'));
      allow delete: if false;
    }

    match /staffCredentials/{uid} {
      allow read: if isAdministrator() || (isActive() && request.auth.uid == uid);
      allow create, update: if isAdministrator()
                            && request.resource.data.uid == uid;
      allow delete: if isAdministrator();
    }

    // Longitudinal structured RP medical records: scoped to existing patients.
    match /patients/{patientId}/recordDocuments/{documentId} {
      allow read: if isActive()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && (get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false || isAdministrator());
      allow create: if canEditPatients()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false
        && request.resource.data.keys().hasOnly(['patientId','category','encounterId','title','body','status','version','amendsId','createdAt','updatedAt'])
        && request.resource.data.patientId == patientId
        && request.resource.data.category in ['Intake','Clinical note','Discharge','Referral','Consent','Imaging report','Laboratory report','Other']
        && request.resource.data.encounterId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 3
        && request.resource.data.body.size() <= 12000
        && request.resource.data.status == 'active'
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 50
        && (
          (request.resource.data.version == 1 && request.resource.data.get('amendsId', '') == '')
          || (
            request.resource.data.version > 1
            && request.resource.data.get('amendsId', '') is string
            && request.resource.data.amendsId != documentId
            && exists(/databases/$(database)/documents/patients/$(patientId)/recordDocuments/$(request.resource.data.amendsId))
            && get(/databases/$(database)/documents/patients/$(patientId)/recordDocuments/$(request.resource.data.amendsId)).data.get('patientId', '') == patientId
            && get(/databases/$(database)/documents/patients/$(patientId)/recordDocuments/$(request.resource.data.amendsId)).data.get('version', 0) == request.resource.data.version - 1
            && get(/databases/$(database)/documents/patients/$(patientId)/recordDocuments/$(request.resource.data.amendsId)).data.get('category', '') == request.resource.data.category
            && get(/databases/$(database)/documents/patients/$(patientId)/recordDocuments/$(request.resource.data.amendsId)).data.get('encounterId', '') == request.resource.data.encounterId
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canEditPatients()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false
        && resource.data.patientId == patientId
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status == 'archived'
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Record-quality identity review; no destructive patient merges.
    match /patients/{patientId}/identityReviews/{reviewId} {
      allow read: if isActive()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && (get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false || isAdministrator());
      allow create: if canEditPatients()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false
        && request.resource.data.keys().hasOnly(['patientId','candidatePatientIds','reason','status','createdAt'])
        && request.resource.data.patientId == patientId
        && request.resource.data.candidatePatientIds is list
        && request.resource.data.candidatePatientIds.size() > 0
        && request.resource.data.candidatePatientIds.size() <= 10
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdministrator()
        && resource.data.status == 'open'
        && request.resource.data.status in ['resolved','dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // File metadata stays under the master patient; Storage bytes are separate.
    match /patients/{patientId}/attachments/{attachmentId} {
      allow read: if isActive()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && (get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false || isAdministrator());
      allow create: if canEditPatients()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false
        && request.resource.data.keys().hasOnly(['patientId','category','encounterId','title','fileName','mimeType','fileSize','storagePath','status','version','supersedesId','createdAt','updatedAt'])
        && request.resource.data.patientId == patientId
        && request.resource.data.category in ['Intake','Clinical note','Discharge','Referral','Consent','Imaging report','Laboratory report','Other']
        && request.resource.data.encounterId is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 140
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 180
        && request.resource.data.mimeType in ['application/pdf','image/png','image/jpeg','text/plain']
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 5242880
        && request.resource.data.storagePath == 'rp-patient-documents/' + patientId + '/' + attachmentId + '/file'
        && request.resource.data.status == 'active'
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version <= 50
        && request.resource.data.supersedesId is string
        && (
          (request.resource.data.supersedesId == '' && request.resource.data.version == 1)
          || (request.resource.data.supersedesId != '' && request.resource.data.supersedesId != attachmentId
            && exists(/databases/$(database)/documents/patients/$(patientId)/attachments/$(request.resource.data.supersedesId))
            && get(/databases/$(database)/documents/patients/$(patientId)/attachments/$(request.resource.data.supersedesId)).data.get('version', 0) == request.resource.data.version - 1)
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canEditPatients()
        && exists(/databases/$(database)/documents/patients/$(patientId))
        && get(/databases/$(database)/documents/patients/$(patientId)).data.get('recordConfidential', false) == false
        && resource.data.patientId == patientId
        && resource.data.status == 'active'
        && request.resource.data.status == 'archived'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isActive();
      allow create: if canManageRegistration()
                    && request.resource.data.get('vitalStatus', 'active') == 'active'
                    && request.resource.data.get('recordConfidential', false) == false
                    && request.resource.data.get('profileLocked', false) == false
                    && !request.resource.data.keys().hasAny([
                      'profileLockReason',
                      'profileLockedByUid',
                      'profileLockedByName',
                      'profileLockedByStaffId',
                      'profileLockedAt',
                      'profileLockEpoch',
                      'profileLockRemovedAt',
                      'profileLockRemovedBy',
                      'profileLockRemovedByName',
                      'profileLockRemovalReason'
                    ]);
      allow update: if isAdministrator()
                    || (
                      canEditPatients()
                      && resource.data.get('vitalStatus', 'active') == 'active'
                      && request.resource.data.get('vitalStatus', 'active') == 'active'
                      && request.resource.data.get('recordConfidential', false) == resource.data.get('recordConfidential', false)
                      && request.resource.data.get('deceasedAccessUids', []) == resource.data.get('deceasedAccessUids', [])
                      && !profileLockFieldsChanged()
                    )
                    || (
                      isProvider()
                      && resource.data.get('vitalStatus', 'active') == 'active'
                      && request.resource.data.get('vitalStatus', 'active') == 'deceased'
                      && request.resource.data.get('recordConfidential', false) == true
                      && request.resource.data.get('recordConfidentialReason', '') == 'deceased'
                      && request.resource.data.get('deceasedAccessUids', []).size() == 0
                      && !profileLockFieldsChanged()
                    );
      // Allow verified demographic identity resolution for an unidentified
      // deceased patient without unlocking or changing confidential/deceased state.
      allow update: if canManageRegistration()
        && resource.data.get('identityStatus', '') == 'unidentified'
        && resource.data.get('vitalStatus', '') == 'deceased'
        && request.resource.data.get('identityStatus', '') == 'verified'
        && request.resource.data.get('identityResolvedBy', '') == request.auth.uid
        && request.resource.data.get('identityResolvedAt', null) == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName','lastName','displayName','dob','identityStatus',
          'identityResolvedBy','identityResolvedAt','identityResolutionReason','updatedAt'
        ])
        && request.resource.data.get('vitalStatus', '') == 'deceased'
        && request.resource.data.get('recordConfidential', false) == resource.data.get('recordConfidential', false)
        && request.resource.data.get('deceasedAccessUids', []) == resource.data.get('deceasedAccessUids', []);
      allow delete: if false; // Cloud Function only, after independent approval
    }

    match /encounters/{encounterId} {
      allow read: if isActive();
      allow create: if canManageRegistration()
                    && get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.get('vitalStatus', 'active') == 'active'
                    && get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)).data.get('currentStatus', '') != 'deceased';
      allow update: if (
        canManageRegistration() && !confidentialEncounterFieldsChanged()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['patientName'])
          || (
            resource.data.patientId is string
            && getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.get('identityStatus', '') == 'verified'
            && request.resource.data.patientName ==
              getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.get('displayName', '')
          ))
      ) || validProviderConfidentialUpdate()
        || validFailedAuthorizationAttempt()
        || validAdministratorCaseUnlock();
      // A Doe identity may be confirmed after an encounter has been sealed or
      // marked deceased. Only synchronize the verified display name, never the
      // clinical or confidentiality fields.
      allow update: if canManageRegistration()
        && resource.data.patientId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientName','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.get('identityStatus', '') == 'verified'
        && request.resource.data.patientName ==
          getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)).data.get('displayName', '');
      allow delete: if isAdministrator();
    }

    match /orders/{orderId} {
      allow read: if isActive();
      allow create: if isProvider();
      allow update: if isProvider() || isNurse() || isTechnician();
      allow delete: if isAdministrator();
    }

    match /results/{resultId} {
      allow read: if isActive();
      allow create: if isProvider() || isTechnician();
      allow update: if isProvider() || isTechnician();
      allow delete: if isAdministrator();
    }

    match /clinicalNotes/{noteId} {
      allow read: if isActive();
      allow create: if isProvider();
      allow update: if isAdministrator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId', 'patientName', 'mrn', 'updatedAt']);
      allow delete: if isAdministrator();
    }

    match /noteAddenda/{addendumId} {
      allow read: if isActive();
      allow create: if isProvider() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdministrator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientId', 'patientName', 'mrn', 'updatedAt']);
      allow delete: if isAdministrator();
    }

    match /observations/{observationId} {
      allow read: if isActive();
      allow create, update: if isNurse() || isProvider();
      allow delete: if isAdministrator();
    }

    match /medicationAdministrations/{administrationId} {
      allow read: if isActive();
      allow create, update: if isNurse();
      allow delete: if isAdministrator();
    }

    match /shifts/{shiftId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'active';
      allow update: if isAdministrator() || (isActive() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdministrator();
    }

    match /handoffs/{handoffId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.senderUid == request.auth.uid && request.resource.data.status == 'open';
      allow update: if isActive();
      allow delete: if isAdministrator();
    }

    match /tasks/{taskId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid && request.resource.data.status == 'open';
      allow update: if isActive();
      allow delete: if isAdministrator();
    }

    match /rooms/{roomId} {
      allow read: if isActive();
      allow create, update: if canManageRooms();
      allow delete: if isAdministrator();
    }

    match /messages/{messageId} {
      allow read: if isActive();
      allow create: if canMessage() && request.resource.data.senderUid == request.auth.uid;
      allow update: if canMessage();
      allow delete: if isAdministrator();
    }

    match /clinicalAlerts/{alertId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdministrator();
    }

    match /emergencyEvents/{eventId} {
      allow read: if isActive();
      allow create, update: if canEmergency();
      allow delete: if isAdministrator();
    }

    match /scenarios/{scenarioId} {
      allow read, create, update, delete: if isAdministrator();
    }

    match /caseRuns/{runId} {
      allow read, create, update, delete: if isAdministrator();
    }

    match /labSpecimens/{specimenId} {
      allow read: if isActive();
      allow create, update: if isProvider() || isNurse() || isTechnician();
      allow delete: if isAdministrator();
    }

    match /imagingStudies/{studyId} {
      allow read: if isActive();
      allow create, update: if isProvider() || isNurse() || isTechnician();
      allow delete: if isAdministrator();
    }

    match /admissions/{admissionId} {
      allow read: if isActive();
      allow create: if isProvider();
      allow update: if isProvider() || isNurse() || isAdministrator();
      allow delete: if isAdministrator();
    }

    match /emsArrivals/{arrivalId} {
      allow read, create, update: if isActive();
      allow delete: if isAdministrator();
    }

    // Simulated patient financial records; never authorizes real collections, claims or payments.
    function isBillingReader() {
      return isActive() && (
        isAdministrator() || permission('billingManage', false) == true || currentUser().role in ['physician','registration']
        || permission('billingAccess', false) == true
      );
    }
    function isBillingManager() {
      return isActive() && (isAdministrator() || permission('billingManage', false) == true);
    }
    function billingInvariant(data, accountId) {
      return data.encounterId == accountId
        && data.patientId is string
        && data.patientName is string
        && data.invoiceNumber is string
        && data.simulated == true
        && data.lineItems is list && data.lineItems.size() > 0 && data.lineItems.size() <= 100
        && data.chargeCents is int && data.chargeCents >= 0 && data.chargeCents <= 1000000000
        && data.insuranceEstimatedCents is int && data.insuranceEstimatedCents >= 0
        && data.insuranceReceivedCents is int && data.insuranceReceivedCents >= 0
        && data.waivedCents is int && data.waivedCents >= 0
        && data.patientPaidCents is int && data.patientPaidCents >= 0
        && data.patientResponsibilityCents is int && data.patientResponsibilityCents >= 0
        && data.patientBalanceCents is int && data.patientBalanceCents >= 0
        && data.insurerBalanceCents is int && data.insurerBalanceCents >= 0
        && data.insuranceEstimatedCents + data.waivedCents <= data.chargeCents
        && data.insuranceReceivedCents <= data.insuranceEstimatedCents
        && data.patientPaidCents <= data.patientResponsibilityCents
        && data.patientResponsibilityCents == data.chargeCents - data.insuranceEstimatedCents - data.waivedCents
        && data.patientBalanceCents == data.patientResponsibilityCents - data.patientPaidCents
        && data.insurerBalanceCents == data.insuranceEstimatedCents - data.insuranceReceivedCents
        && data.billingMode in ['patient','insurance','split','waived']
        && data.claimStatus in ['not-applicable','not-submitted','submitted','pending','approved','denied','paid','partially-paid']
        && data.status in ['open','insurance-pending','partially-paid','paid','waived']
        && data.insuranceProvider is string && data.insuranceProvider.size() <= 100
        && data.get("paymentDueDate", "") is string && data.get("paymentDueDate", "").size() <= 10
        && data.waiverReason is string && data.waiverReason.size() <= 500
        && data.notes is string && data.notes.size() <= 1500
        && (data.waivedCents == 0 || data.waiverReason.size() >= 5)
        && (data.insuranceEstimatedCents == 0 || data.insuranceProvider.size() >= 1);
    }
    match /serviceCatalog/{serviceId} {
      allow read: if isBillingReader() || isProvider();
      allow create: if isBillingManager()
        && request.resource.data.keys().hasOnly([
          'name','kind','code','priceCents','active','version','createdBy','createdAt','updatedBy','updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.kind in ['visit','order','procedure','ems','room','service']
        && request.resource.data.code is string
        && request.resource.data.code.size() <= 40
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents >= 0
        && request.resource.data.priceCents <= 999999999
        && request.resource.data.active == true
        && request.resource.data.version == 1
        && (
          request.resource.data.get('source', '') != 'retrospective-waiver'
          || (
            isAdministrator()
            && request.resource.data.waivedCents == request.resource.data.chargeCents
            && request.resource.data.patientBalanceCents == 0
            && request.resource.data.insuranceEstimatedCents == 0
            && request.resource.data.patientPaidCents == 0
          )
        )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isBillingManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'priceCents','active','version','updatedBy','updatedAt'
        ])
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents >= 0
        && request.resource.data.priceCents <= 999999999
        && request.resource.data.active is bool
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdministrator();
      match /revisions/{revisionId} {
        allow read: if isBillingReader();
        allow create: if isBillingManager()
          && request.resource.data.keys().hasOnly(['action','priceCents','previousPriceCents','name','actorUid','at','reason'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.action in ['created','price-updated','archived','reactivated']
          && request.resource.data.priceCents is int
          && request.resource.data.priceCents >= 0;
        allow update: if false;
        allow delete: if isAdministrator();
      }
    }

    match /serviceCatalogDeletions/{deletionId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator()
        && request.resource.data.keys().hasOnly([
          'serviceId','name','kind','code','priceCents','version',
          'revisionCount','reason','actorUid','at'
        ])
        && request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.kind in ['visit','order','procedure','ems','room','service']
        && request.resource.data.code is string
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents >= 0
        && request.resource.data.version is int
        && request.resource.data.revisionCount is int
        && request.resource.data.revisionCount >= 0
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 250
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    match /billingAccounts/{encounterId} {
      allow read: if isBillingReader();
      allow create: if (isProvider() || isBillingManager())
        && request.resource.data.keys().hasOnly([
          'encounterId','patientId','patientName','invoiceNumber','lineItems',
          'chargeCents','insuranceEstimatedCents','insuranceReceivedCents',
          'waivedCents','patientPaidCents','patientResponsibilityCents',
          'patientBalanceCents','insurerBalanceCents','insuranceProvider','paymentDueDate',
          'claimStatus','waiverReason','notes','billingMode','status',
          'createdBy','updatedBy','createdAt','updatedAt','source','simulated'
        ])
        && billingInvariant(request.resource.data, encounterId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId))
        && getAfter(/databases/$(database)/documents/encounters/$(encounterId)).data.patientId == request.resource.data.patientId
        && getAfter(/databases/$(database)/documents/encounters/$(encounterId)).data.status == 'discharged';
      allow update: if isBillingManager()
        && billingInvariant(request.resource.data, encounterId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lineItems','chargeCents','insuranceEstimatedCents','insuranceReceivedCents',
          'waivedCents','patientPaidCents','patientResponsibilityCents',
          'patientBalanceCents','insurerBalanceCents','claimStatus','waiverReason',
          'notes','status','insuranceProvider','paymentDueDate','updatedBy','updatedAt','adjustmentAuditId'
        ])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adjustmentAuditId','lineItems','chargeCents','waivedCents'])
          || (
            request.resource.data.adjustmentAuditId is string
            && getAfter(/databases/$(database)/documents/billingAccounts/$(encounterId)/events/$(request.resource.data.adjustmentAuditId)).data.actorUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/billingAccounts/$(encounterId)/events/$(request.resource.data.adjustmentAuditId)).data.createdAt == request.time
            && (
              (
                isAdministrator()
                && getAfter(/databases/$(database)/documents/billingAccounts/$(encounterId)/events/$(request.resource.data.adjustmentAuditId)).data.action in ['bulk-waiver','charge-override','line-override','charge','charge-correction','waiver']
              )
              || (
                getAfter(/databases/$(database)/documents/billingAccounts/$(encounterId)/events/$(request.resource.data.adjustmentAuditId)).data.action in ['charge','charge-correction','waiver']
              )
            )
          )
        );
      allow delete: if false;
      match /events/{eventId} {
        allow read: if isBillingReader();
        allow create: if isBillingManager()
          && request.resource.data.keys().hasOnly(['action','amountCents','detail','reason','actorUid','createdAt','simulated'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.simulated == true
          && request.resource.data.createdAt == request.time
          && request.resource.data.action in ['patient-payment','insurance-payment','patient-refund','insurance-refund','coverage','waiver','charge','charge-correction','insurer','due-date','claim','note','bulk-waiver','charge-override','line-override']
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents >= 0
          && request.resource.data.detail is string && request.resource.data.detail.size() <= 250
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 750;
        allow update, delete: if false;
      }
    }

    match /dischargePlans/{planId} {
      allow read: if isActive();
      allow create, update: if isProvider();
      allow delete: if isAdministrator();
    }

    match /procedures/{procedureId} {
      allow read: if isActive();
      allow create, update: if isProvider() || isNurse();
      allow delete: if isAdministrator();
    }

    match /bloodBankRequests/{requestId} {
      allow read: if isActive();
      allow create, update: if isProvider() || isNurse() || isTechnician();
      allow delete: if isAdministrator();
    }

    match /supplyItems/{itemId} {
      allow read: if isActive();
      allow create, update, delete: if isAdministrator();
    }

    match /breakGlassEvents/{eventId} {
      allow read: if isAdministrator() || (isActive() && resource.data.userUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if false;
    }


    // SIU reports: staff can file and see only their own. Investigators must be
    // explicitly authorized by an administrator through users.permissions.
    function isSIU() {
      return isAdministrator() || (isActive() && permission('siuInvestigations', false) == true);
    }

    match /siuCases/{caseId} {
      allow get, list: if isSIU() || (isActive() && resource.data.reporterUid == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
          'reporterUid','reporterName','category','priority','title','occurredAt',
          'location','involved','description','actions','status','assignedUid',
          'finding','resolution','createdAt','updatedAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.assignedUid == ''
        && request.resource.data.finding == ''
        && request.resource.data.resolution == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 8000
        && request.resource.data.category in [
          'Patient safety','Staff misconduct','Medication discrepancy',
          'Record or privacy concern','Fraud or falsification',
          'Harassment or retaliation','Equipment or facility','Other'
        ]
        && request.resource.data.priority in ['routine','high','critical'];
      allow update: if isSIU()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','assignedUid','finding','resolution','updatedAt'
        ])
        && request.resource.data.status in ['open','triage','investigating','review','closed']
        && request.resource.data.finding in ['', 'substantiated', 'unsubstantiated','inconclusive','referred','withdrawn']
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.status != 'closed' || (request.resource.data.finding != '' && request.resource.data.resolution is string && request.resource.data.resolution.size() >= 5));
      allow delete: if false;

      // Private append-only investigator record; submitters cannot view SIU notes.
      match /timeline/{eventId} {
        allow read: if isSIU();
        allow create: if isSIU()
          && request.resource.data.keys().hasOnly(['kind','message','actorUid','createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.kind in ['note','interview','evidence','action','change']
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 5
          && request.resource.data.message.size() <= 5000;
        allow update, delete: if false;
      }
    }

    // Non-clinical operations register: patient identifiers/medical details are prohibited by UI policy.
    // This register is not a substitute for patient charts or medication systems.
    function canManageOps(module) {
      return isAdministrator()
        || (isActive()
            && module in ['beds','transport','shift']
            && permission('manageRooms', false) == true);
    }
    match /northstarOps/{recordId} {
      allow read: if isActive();
      allow create: if canManageOps(request.resource.data.module)
        && request.resource.data.keys().hasOnly(['module','title','department','priority','summary','dueDate','status','createdBy','updatedBy','createdAt','updatedAt'])
        && request.resource.data.module in ['beds','transport','shift','quality','credentials','policy','forms']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4 && request.resource.data.title.size() <= 120
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0 && request.resource.data.department.size() <= 90
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 5 && request.resource.data.summary.size() <= 2500
        && request.resource.data.dueDate is string
        && request.resource.data.priority in ['routine','high','critical']
        && request.resource.data.status == 'open'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canManageOps(resource.data.module)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy'])
        && request.resource.data.status in ['open','assigned','in-progress','on-hold','completed','cancelled']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Northstar 3.0 managed operational records. These are intentionally separate
    // from the clinical chart, SIU reports and historical financial accounts.
    function v3CreatorFields() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function v3StatusUpdate(allowedStatuses) {
      return isAdministrator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','updatedBy'])
        && request.resource.data.status in allowedStatuses
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /nmcQualityActions/{actionId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator()
        && request.resource.data.keys().hasOnly(['title','category','priority','summary','dueDate','status','createdBy','updatedBy','createdAt','updatedAt'])
        && v3CreatorFields()
        && request.resource.data.status == 'open'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4 && request.resource.data.title.size() <= 120
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 5 && request.resource.data.summary.size() <= 800
        && request.resource.data.category in ['patient-safety','medication','documentation','equipment','operations','training']
        && request.resource.data.priority in ['routine','high','critical']
        && request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 10;
      allow update: if v3StatusUpdate(['open','assigned','in-progress','completed','cancelled']);
      allow delete: if false;
    }

    match /nmcEquipment/{equipmentId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator()
        && request.resource.data.keys().hasOnly(['name','assetCode','department','status','nextServiceDate','createdBy','updatedBy','createdAt','updatedAt'])
        && v3CreatorFields()
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.assetCode is string && request.resource.data.assetCode.size() >= 2 && request.resource.data.assetCode.size() <= 50
        && request.resource.data.department is string && request.resource.data.department.size() >= 2 && request.resource.data.department.size() <= 80
        && request.resource.data.status in ['available','in-use','maintenance','out-of-service']
        && request.resource.data.nextServiceDate is string && request.resource.data.nextServiceDate.size() <= 10;
      allow update: if v3StatusUpdate(['available','in-use','maintenance','out-of-service']);
      allow delete: if false;
    }

    match /nmcShiftAssignments/{assignmentId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator()
        && request.resource.data.keys().hasOnly(['staffUid','department','shiftDate','startTime','endTime','status','createdBy','updatedBy','createdAt','updatedAt'])
        && v3CreatorFields()
        && request.resource.data.staffUid is string && request.resource.data.staffUid.size() > 0
        && exists(userPath(request.resource.data.staffUid))
        && get(userPath(request.resource.data.staffUid)).data.status == 'active'
        && request.resource.data.department in ['Emergency','ICU','Surgery','Laboratory','Imaging','Pharmacy','Registration','Administration']
        && request.resource.data.shiftDate is string && request.resource.data.shiftDate.size() == 10
        && request.resource.data.startTime is string && request.resource.data.startTime.size() == 5
        && request.resource.data.endTime is string && request.resource.data.endTime.size() == 5
        && request.resource.data.startTime < request.resource.data.endTime
        && request.resource.data.status == 'scheduled';
      allow update: if v3StatusUpdate(['scheduled','confirmed','completed','cancelled']);
      allow delete: if false;
    }

    match /nmcTrainingRecords/{trainingId} {
      allow read: if isAdministrator();
      allow create: if isAdministrator()
        && request.resource.data.keys().hasOnly(['staffUid','module','title','dueDate','status','createdBy','updatedBy','createdAt','updatedAt'])
        && v3CreatorFields()
        && request.resource.data.staffUid is string && request.resource.data.staffUid.size() > 0
        && exists(userPath(request.resource.data.staffUid))
        && get(userPath(request.resource.data.staffUid)).data.status == 'active'
        && request.resource.data.module in ['emergency','medication','documentation','billing','privacy','siu']
        && request.resource.data.title is string && request.resource.data.title.size() >= 4 && request.resource.data.title.size() <= 120
        && request.resource.data.dueDate is string && request.resource.data.dueDate.size() <= 10
        && request.resource.data.status == 'assigned';
      allow update: if v3StatusUpdate(['assigned','in-progress','completed','cancelled']);
      allow delete: if false;
    }

    // Northstar 4.0 — independent, role-scoped department worklists.
    // Every client create/status update must include a matching immutable audit
    // document in the same atomic write batch.
    function v4Role(roles) {
      return isActive() && currentUser().role in roles;
    }
    function v4Created() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auditEventId is string;
    }
    function v4Audit(collectionName, recordId, action) {
      let audit = getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data;
      return audit.actorUid == request.auth.uid
        && audit.collection == collectionName
        && audit.recordId == recordId
        && audit.action == action
        && audit.to == request.resource.data.status
        && audit.createdAt == request.time;
    }
    function v4Update(collectionName,recordId,statuses) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','updatedBy','updatedAt','auditEventId'
        ])
        && request.resource.data.status in statuses
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auditEventId != resource.data.get('auditEventId', '')
        && v4Audit(collectionName,recordId,'status');
    }
    function v4PatientEncounter() {
      return request.resource.data.patientId is string
        && request.resource.data.encounterId is string
        && exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId))
        && exists(/databases/$(database)/documents/encounters/$(request.resource.data.encounterId))
        && get(/databases/$(database)/documents/encounters/$(request.resource.data.encounterId)).data.patientId
            == request.resource.data.patientId
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() <= 120;
    }
    match /nmcDepartmentAudit/{auditId} {
      allow read: if isAdministrator();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly([
          'collection','recordId','action','from','to','reason','actorUid','createdAt'
        ])
        && request.resource.data.collection in [
          'nmcSurgicalCases','nmcInfectionReviews','nmcSterileTrays',
          'nmcTransportRequests','nmcPharmacyDispenses','nmcPharmacyStock',
          'nmcSterileRequests'
        ]
        && request.resource.data.recordId is string
        && request.resource.data.recordId.size() >= 1
        && request.resource.data.action in ['created','status','stock-adjustment']
        && request.resource.data.from is string
        && request.resource.data.to is string
        && request.resource.data.keys().hasOnly([
          'collection','recordId','action','from','to','reason','actorUid','createdAt'
        ])
        && request.resource.data.get('reason','') is string
        && request.resource.data.get('reason','').size() <= 200
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.recordId)).data.auditEventId == auditId;
      allow update, delete: if false;
    }
    match /nmcSurgicalCases/{caseId} {
      allow read: if v4Role(['administrator','physician','nurse']);
      allow create: if v4Role(['administrator','physician'])
        && request.resource.data.keys().hasOnly([
          'patientId','encounterId','patientName','procedureName','room','scheduledDate',
          'priority','assignedUid','consentStatus','preopStatus','anesthesiaStatus','recoveryLocation','status','createdBy','updatedBy','createdAt','updatedAt','auditEventId'
        ])
        && v4Created() && v4PatientEncounter()
        && request.resource.data.status == 'scheduled'
        && request.resource.data.procedureName is string && request.resource.data.procedureName.size() >= 2 && request.resource.data.procedureName.size() <= 140
        && request.resource.data.room is string && request.resource.data.room.size() > 0 && request.resource.data.room.size() <= 50
        && request.resource.data.scheduledDate is string && request.resource.data.scheduledDate.size() == 10
        && request.resource.data.priority in ['routine','urgent','emergency']
        && request.resource.data.get('consentStatus','pending') in ['pending','documented']
        && request.resource.data.get('preopStatus','pending') in ['pending','reviewed']
        && request.resource.data.get('anesthesiaStatus','pending') in ['pending','requested','reviewed']
        && request.resource.data.get('recoveryLocation','PACU') in ['PACU','ICU','Inpatient','Observation']
        && request.resource.data.assignedUid is string
        && v4Audit('nmcSurgicalCases',caseId,'created');
      allow update: if v4Role(['administrator','physician','nurse'])
        && v4Update('nmcSurgicalCases',caseId,['scheduled','preparing','in-progress','recovery','completed','cancelled']);
      allow delete: if false;
    }
    match /nmcInfectionReviews/{reviewId} {
      allow read: if v4Role(['administrator','physician','nurse']);
      allow create: if v4Role(['administrator','physician','nurse'])
        && request.resource.data.keys().hasOnly([
          'patientId','encounterId','patientName','reason','precautions','summary','status',
          'createdBy','updatedBy','createdAt','updatedAt','auditEventId'
        ])
        && v4Created() && v4PatientEncounter()
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 160
        && request.resource.data.precautions in ['standard','contact','droplet','airborne','review']
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 240
        && v4Audit('nmcInfectionReviews',reviewId,'created');
      allow update: if v4Role(['administrator','physician','nurse'])
        && v4Update('nmcInfectionReviews',reviewId,['open','precautions','review','resolved','closed']);
      allow delete: if false;
    }
    match /nmcSterileTrays/{trayId} {
      allow read: if v4Role(['administrator','technician','nurse']);
      allow create: if v4Role(['administrator','technician'])
        && request.resource.data.keys().hasOnly([
          'trayName','trayCode','department','status','createdBy','updatedBy','createdAt','updatedAt','auditEventId'
        ])
        && v4Created()
        && request.resource.data.status == 'available'
        && request.resource.data.trayName is string && request.resource.data.trayName.size() >= 3 && request.resource.data.trayName.size() <= 120
        && request.resource.data.trayCode is string && request.resource.data.trayCode.size() >= 2 && request.resource.data.trayCode.size() <= 50
        && request.resource.data.department is string && request.resource.data.department.size() > 0 && request.resource.data.department.size() <= 80
        && v4Audit('nmcSterileTrays',trayId,'created');
      allow update: if v4Role(['administrator','technician'])
        && v4Update('nmcSterileTrays',trayId,['available','in-use','decontamination','sterilizing','inspection','quarantined']);
      allow delete: if false;
    }
    match /nmcSterileRequests/{requestId} {
      allow read: if v4Role(['administrator','technician','nurse','physician']);
      // Requests are created by a verified surgical-case backend trigger.
      allow create, delete: if false;
      allow update: if v4Role(['administrator','technician'])
        && v4Update('nmcSterileRequests',requestId,['requested','preparing','ready','delivered','cancelled']);
    }
    match /nmcTransportRequests/{requestId} {
      allow read: if v4Role(['administrator','nurse','technician','registration','physician']);
      allow create: if v4Role(['administrator','nurse','technician','registration'])
        && request.resource.data.keys().hasOnly([
          'patientId','encounterId','patientName','origin','destination','priority','assignedUid',
          'status','createdBy','updatedBy','createdAt','updatedAt','auditEventId'
        ])
        && v4Created() && v4PatientEncounter()
        && request.resource.data.status == 'requested'
        && request.resource.data.origin is string && request.resource.data.origin.size() > 0 && request.resource.data.origin.size() <= 100
        && request.resource.data.destination is string && request.resource.data.destination.size() > 0 && request.resource.data.destination.size() <= 100
        && request.resource.data.priority in ['routine','urgent','stat']
        && request.resource.data.assignedUid is string
        && v4Audit('nmcTransportRequests',requestId,'created');
      allow update: if v4Role(['administrator','nurse','technician','registration'])
        && v4Update('nmcTransportRequests',requestId,['requested','assigned','en-route','arrived','completed','cancelled']);
      allow delete: if false;
    }
    match /nmcPharmacyStock/{stockId} {
      allow read: if v4Role(['administrator','pharmacist','physician','nurse']);
      allow create: if v4Role(['administrator','pharmacist'])
        && request.resource.data.keys().hasOnly([
          'itemName','sku','quantity','location','status','createdBy','updatedBy',
          'createdAt','updatedAt','auditEventId'
        ])
        && v4Created()
        && request.resource.data.itemName is string
        && request.resource.data.itemName.size() >= 2 && request.resource.data.itemName.size() <= 120
        && request.resource.data.sku is string
        && request.resource.data.sku.size() >= 2 && request.resource.data.sku.size() <= 50
        && request.resource.data.location is string
        && request.resource.data.location.size() >= 1 && request.resource.data.location.size() <= 80
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0 && request.resource.data.quantity <= 100000
        && request.resource.data.status == 'available'
        && v4Audit('nmcPharmacyStock',stockId,'created');
      allow update: if v4Role(['administrator','pharmacist'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity','updatedAt','updatedBy','auditEventId'
        ])
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0 && request.resource.data.quantity <= 100000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auditEventId != resource.data.auditEventId
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.action == 'stock-adjustment'
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.collection == 'nmcPharmacyStock'
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.recordId == stockId
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.to == string(request.resource.data.quantity)
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.from == string(resource.data.quantity)
        && getAfter(/databases/$(database)/documents/nmcDepartmentAudit/$(request.resource.data.auditEventId)).data.reason.size() >= 5;
      allow delete: if false;
    }
    match /nmcPharmacyDispenses/{requestId} {
      allow read: if v4Role(['administrator','pharmacist','physician','nurse']);
      allow create: if v4Role(['administrator','pharmacist','physician'])
        && request.resource.data.keys().hasOnly([
          'patientId','encounterId','patientName','orderId','medicationName','quantity',
          'note','status','createdBy','updatedBy','createdAt','updatedAt','auditEventId'
        ])
        && v4Created() && v4PatientEncounter()
        && request.resource.data.status == 'requested'
        && request.resource.data.medicationName is string && request.resource.data.medicationName.size() > 0 && request.resource.data.medicationName.size() <= 120
        && request.resource.data.quantity is string
        && request.resource.data.quantity.matches('^[0-9]{1,5}$')
        && request.resource.data.orderId is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.patientId == request.resource.data.patientId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.encounterId == request.resource.data.encounterId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.category == 'medication'
        && request.resource.data.note is string && request.resource.data.note.size() <= 220
        && v4Audit('nmcPharmacyDispenses',requestId,'created');
      allow update: if v4Role(['administrator','pharmacist'])
        && v4Update('nmcPharmacyDispenses',requestId,['requested','verified','dispensed','returned','cancelled']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
